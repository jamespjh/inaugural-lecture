digraph example1 {
    // Use neato layout engine for this diagram
    graph [layout="neato", rankdir="LR", splines="curved", bgcolor="transparent"];
    
    // Node definitions
    node [shape="box", style="filled", fillcolor="lightblue", fontcolor="black"];
    
    // Edge definitions  
    edge [color="darkblue", fontcolor="darkblue", arrowsize=0.8];
    
    // Diagram content
    "Server" -> "Switch" -> "Router";
    "Switch" -> "Client";
    "Router" -> "Database";
    
    // Additional connections
    "Client" -> "Database";
}