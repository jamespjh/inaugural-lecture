digraph snake {
    // Snake layout using neato with pinned positions.
    // The '!' suffix on pos fixes each node in place; neato then routes
    // edges around them.
    // Row 1 (top):    A B C D   (left → right)
    // Connector:      D → E     (drop down at right)
    // Row 2 (middle): E F G H   (right → left)
    // Connector:      H → I     (drop down at left)
    // Row 3 (bottom): I J       (left → right)
    graph [layout="neato", splines="ortho", bgcolor="transparent"];
    node  [shape="box", style="filled", fillcolor="lightblue", fontcolor="black"];
    edge  [color="darkblue", arrowsize=0.8];

    A [pos="0,2!"];
    B [pos="1,2!"];
    C [pos="2,2!"];
    D [pos="3,2!"];
    E [pos="3,1!"];
    F [pos="2,1!"];
    G [pos="1,1!"];
    H [pos="0,1!"];
    I [pos="0,0!"];
    J [pos="1,0!"];

    A -> B -> C -> D -> E -> F -> G -> H -> I -> J;
}